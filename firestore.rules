rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Browser clients do not access Firestore directly. Profiles, reports,
    // resources, and classes are authorized by the Express server using the
    // verified Firebase UID and firebase-admin, which bypasses these rules.
    // Keep direct client access denied until a client data model has explicit
    // ownership and teacher/student authorization rules.
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
